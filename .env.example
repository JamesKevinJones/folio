# Folio environment
GOOGLE_API_KEY=
# Optional — not required. Voice uses free browser Web Speech by default.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional overrides
# HOST=127.0.0.1
# PORT=8787
# LLM_MODEL=gemini-flash-latest
# TTS_VOICE=nova
# STT_MODEL=whisper-1        # OpenAI transcription, only with OPENAI_API_KEY
# TTS_MODEL=tts-1            # OpenAI speech, only with OPENAI_API_KEY
# DATA_DIR=./data            # sessions and exported briefs

# Companion UI build only (apps/companion): API origin when the UI is hosted
# separately. Empty means same origin, which is what `uv run folio` serves.
# VITE_API_BASE=
